[Desktop Entry]
Name=Freelens
Exec=freelens --ozone-platform-hint=auto --enable-features=WebRTCPipeWireCapturer --enable-features=WaylandWindowDecorations --disable-gpu-compositing %U
Terminal=false
Type=Application
Icon=freelens
StartupWMClass=Freelens
Comment=Freelens - Free IDE for Kubernetes
MimeType=x-scheme-handler/freelens;
Categories=Development;Network;
